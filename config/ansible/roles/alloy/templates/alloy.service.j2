[Unit]
Description=Grafana Alloy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=alloy
Group=alloy
{% if alloy_node_role == 'edge' %}
SupplementaryGroups=adm
{% endif %}
Environment="ARP_ALLOY_NODE={{ inventory_hostname }}"
Environment="ARP_ALLOY_ROLE={{ alloy_node_role }}"
Environment="ARP_PROMETHEUS_REMOTE_WRITE_URL=http://{{ '127.0.0.1' if alloy_node_role == 'observability' else observability_private_ip }}:9090/api/v1/write"
Environment="ARP_LOKI_PUSH_URL=http://{{ '127.0.0.1' if alloy_node_role == 'observability' else observability_private_ip }}:3100/loki/api/v1/push"
Environment="ARP_TEMPO_OTLP_HTTP_ENDPOINT=http://{{ '127.0.0.1' if alloy_node_role == 'observability' else observability_private_ip }}:4318"
ExecStart=/usr/local/bin/alloy run \
  --storage.path=/var/lib/alloy \
  --server.http.listen-addr=127.0.0.1:12345 \
  --disable-reporting \
  /etc/alloy/config.alloy
Restart=on-failure
RestartSec=5s
MemoryMax={{ alloy_memory_limit }}
CPUQuota={{ alloy_cpu_quota }}
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
