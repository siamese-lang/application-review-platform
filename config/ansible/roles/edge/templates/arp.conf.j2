upstream arp_backend {
  server {{ app_private_ip }}:8080;
  keepalive 16;
}

server {
  listen 80 default_server;
  access_log /var/log/nginx/arp-access.log arp_json;
  error_log /var/log/nginx/arp-error.log warn;
  location ^~ /actuator { return 404; }
  location ^~ /.well-known/acme-challenge/ { root /var/lib/acme; }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl default_server;
  access_log /var/log/nginx/arp-access.log arp_json;
  error_log /var/log/nginx/arp-error.log warn;
  location ^~ /actuator { return 404; }
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  root /opt/arp/frontend/current;
  index index.html;
  include /etc/nginx/snippets/arp-spa.conf;
}
